# Copy to .env (`make setup` does this and generates the two tokens).
# Every variable maps 1:1 to a field of helpdesk.shared.settings.Settings.
# docker-compose passes each service only the variables it needs.

# --- secrets (never commit real values) --------------------------------------
# MCP server -> mock bearer token. The agent never gets this one.
MOCK_API_TOKEN=
# Mock admin endpoints (/admin/chaos, /admin/writes), used by make targets and evals.
MOCK_ADMIN_TOKEN=
# Claude API key (MODEL_PROVIDER=anthropic).
ANTHROPIC_API_KEY=
# Only for MODEL_PROVIDER=openai.
OPENAI_API_KEY=

# --- model --------------------------------------------------------------------
# anthropic | bedrock | openai | fake
MODEL_PROVIDER=anthropic
MODEL_NAME=claude-sonnet-5-5
MODEL_MAX_TOKENS=1024
# Empty = provider default. claude-sonnet-5-5 rejects non-default values.
MODEL_TEMPERATURE=
MODEL_TIMEOUT_S=60
# SDK retries for the model API only. Tool calls are retried only by the MCP server.
MODEL_MAX_RETRIES=2
# Only for MODEL_PROVIDER=bedrock (AWS credentials come from the usual AWS env/profile).
AWS_REGION=
# Only for MODEL_PROVIDER=fake: JSON file of scripted AI messages.
FAKE_MODEL_SCRIPT=

# --- agent --------------------------------------------------------------------
AGENT_HOST=127.0.0.1
AGENT_PORT=8080
MCP_URL=http://127.0.0.1:8001/mcp
CHECKPOINT_DB_PATH=data/checkpoints.sqlite
STORE_DB_PATH=data/store.sqlite
RECURSION_LIMIT=25
TURN_DEADLINE_S=90
HISTORY_TOKEN_BUDGET=8000
FACT_TTL_DAYS=90
SLOW_TOOL_NOTICE_S=3
WEB_DIR=web

# --- MCP server -----------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8001
MOCK_URL=http://127.0.0.1:8000
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_S=0.5
RETRY_AFTER_CAP_S=5
TOOL_ATTEMPT_TIMEOUT_S=5
TOOL_DEADLINE_S=15

# --- mock ---------------------------------------------------------------------
MOCK_HOST=127.0.0.1
MOCK_PORT=8000
MOCK_DB_PATH=data/mock.sqlite
CHAOS_ENABLED=false
CHAOS_RATE_LIMIT_RATE=0
CHAOS_ERROR_RATE=0
CHAOS_SLOW_RATE=0
CHAOS_SLOW_MS=2000
# Every chaos run is seeded (reproducible); change the seed to get a different sequence.
CHAOS_SEED=0
# "The write committed but the response was lost" (CONTRACTS.md §1.6).
CHAOS_FAIL_AFTER_COMMIT_RATE=0
CHAOS_RETRY_AFTER_S=1

# --- telemetry ------------------------------------------------------------------
LOG_LEVEL=INFO
TRACES_DIR=traces
# Empty = JSONL only. Set by `make up OBS=1` for the compose `observability` profile.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Shown as a link next to the trace id in the web UI, e.g. http://localhost:16686
JAEGER_UI_URL=
TRACE_RESULT_MAX_BYTES=2048
